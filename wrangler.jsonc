// One Worker serves every shop (worker/index.js). Shops and their domains are listed in shops.json;
// each shop's domain is attached to this Worker as a custom domain.
{
  "name": "pullwise",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Every request goes to the Worker first so it can serve each shop's config.js and page titles;
    // anything else it hands straight to the static files.
    "run_worker_first": true,
    // An address with no file gets 404.html with a 404 status; the Worker brands it like the other pages.
    "not_found_handling": "404-page"
  },
  // Covers and series images for shops marked "media": "r2" (worker/media.js). The bucket must exist before a
  // deploy; MEDIA_PUBLIC_URL is the custom domain connected to it (R2 → the bucket → Settings → Custom Domains).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pullwise-media" }],
  "vars": { "MEDIA_PUBLIC_URL": "https://images.pullwise.shop" },
  "observability": { "enabled": true }
}
