// One Worker serves every shop (worker/index.js). Shops and their domains are listed in shops.json;
// each shop's domain is attached to this Worker as a custom domain.
{
  "name": "pullwise",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Every request goes to the Worker first so it can serve each shop's config.js and page titles;
    // anything else it hands straight to the static files.
    "run_worker_first": true,
    // An address with no file gets 404.html with a 404 status; the Worker brands it like the other pages.
    "not_found_handling": "404-page"
  },
  // Covers and series images for shops marked "media": "r2" (worker/media.js). The bucket must exist before a
  // deploy; MEDIA_PUBLIC_URL is the custom domain connected to it (R2 → the bucket → Settings → Custom Domains).
  // BACKUPS is the private bucket the nightly backup writes (tools/backup-shops.mjs) and Backup → Nightly Backups lists
  // (worker/backups.js). It has no public address; the Deploy workflow creates it if it's missing.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "pullwise-media" },
    { "binding": "BACKUPS", "bucket_name": "pullwise-backups" }
  ],
  // Rate limit for the public catalog feed (worker/catalog-feed.js): 60 requests a minute per client address.
  "ratelimits": [{ "name": "CATALOG_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // GITHUB_REPO is where the catalog's "Run now" buttons start the daily import Actions (worker/catalog-import.js), with
  // the GITHUB_TOKEN Worker secret (SETUP.md → Run the catalog imports from the admin).
  "vars": { "MEDIA_PUBLIC_URL": "https://images.pullwise.shop", "GITHUB_REPO": "charger71/pullwise-main" },
  "observability": { "enabled": true },
  // Preview builds of non-production branches (`wrangler preview`) refuse to run without this block. Empty means a
  // Preview gets no R2 bucket or vars, so it can't upload media (worker/media.js answers 404) and never touches production's.
  "previews": {}
}
